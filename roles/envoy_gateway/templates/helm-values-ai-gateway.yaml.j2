# Envoy Gateway Helm values for AI Gateway + InferencePool integration.
# Merged from:
#   envoyproxy/ai-gateway manifests/envoy-gateway-values.yaml
#   envoyproxy/ai-gateway examples/inference-pool/envoy-gateway-values-addon.yaml

config:
  envoyGateway:
    gateway:
      controllerName: gateway.envoyproxy.io/gatewayclass-controller
    logging:
      level:
        default: info
    provider:
      type: Kubernetes
    extensionApis:
      enableEnvoyPatchPolicy: true
      enableBackend: true
    extensionManager:
      hooks:
        xdsTranslator:
          translation:
            listener:
              includeAll: true
            route:
              includeAll: true
            cluster:
              includeAll: true
            secret:
              includeAll: true
          post:
            - Translation
            - Cluster
            - Route
      # Enable InferencePool as a backend resource
      backendResources:
        - group: inference.networking.k8s.io
          kind: InferencePool
          version: v1
      service:
        fqdn:
          hostname: "{{ envoy_gateway_ai_controller_service }}.{{ envoy_gateway_ai_controller_namespace }}.svc.cluster.local"
          port: 1063

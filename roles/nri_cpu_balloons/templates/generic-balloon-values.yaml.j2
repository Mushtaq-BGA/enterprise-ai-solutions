# Generic NRI Balloon Policy Template for vLLM Models (Simplified)
config:
  agent:
    nodeResourceTopology: true
    podResourceAPI: false
  allocatorTopologyBalancing: true
  pinCPU: true
  pinMemory: false
  reservedResources:
    cpu: "cpuset:{{ _nri_reserved_cpu_list }}"
  balloonTypes:
    - name: "{{ balloon_name }}"
      matchExpressions:
        - key: "{{ match_label_key }}"
          operator: In
          values:
{% for v in match_label_values %}
            - "{{ v }}"
{% endfor %}
      minCPUs: {{ workload_cpus }}
      maxCPUs: 1024
      allocatorPriority: "high"
    - name: "reserved"
      allocatorPriority: "high"
      namespaces:
        - "*"
  log:
    source: true
    debug:
      - policy

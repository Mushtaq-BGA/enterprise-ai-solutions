---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: "{{ metallb_pool_name }}"
  namespace: "{{ metallb_namespace }}"
spec:
  addresses:
    - "{{ metallb_ip_range }}"
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: "{{ metallb_pool_name }}-l2"
  namespace: "{{ metallb_namespace }}"
spec:
  ipAddressPools:
    - "{{ metallb_pool_name }}"
